{
  "name": "Levanter / Raganork",
  "description": "WhatsApp bot deployment (Levanter + Raganork)",
  "keywords": ["nodejs", "whatsapp-bot"],
  "repository": "https://github.com/erenyean/raganork-md",
  "success_url": "/",
  "stack": "container",
  "env": {
    "SESSION_ID": {
      "description": "Session ID (single or multi)",
      "required": true,
      "value": ""
    },
    "HEROKU_APP_NAME": {
      "description": "Heroku app name",
      "required": true,
      "value": ""
    },
    "HEROKU_API_KEY": {
      "description": "Heroku account API key",
      "required": true,
      "value": ""
    },
    "SUDO": {
      "description": "Admin user(s) JID(s), comma-separated",
      "required": false,
      "value": ""
    },
    "REJECT_CALL": {
      "description": "Auto reject calls (true/false)",
      "required": false,
      "value": "false"
    },
    "ALWAYS_ONLINE": {
      "description": "Show bot’s last seen as online (true/false)",
      "required": false,
      "value": "false"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "buildpacks": [],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
